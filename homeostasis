<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clinical Inquiry Lab - Homeostasis Sim</title>
    <style>
        :root {
            --acid-red: #dc3545;
            --normal-green: #198754;
            --alkali-purple: #6f42c1;
            --dark-slate: #212529;
            --light-bg: #f8f9fa;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.6;
            color: var(--dark-slate);
            background-color: var(--light-bg);
            margin: 0;
            padding: 20px;
        }

        .sim-container {
            max-width: 900px;
            margin: 0 auto;
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        h1, h2, h3 {
            color: #0d6efd;
            margin-top: 0;
        }

        .clinical-scenario {
            background-color: #e7f1ff;
            border-left: 5px solid #0d6efd;
            padding: 15px;
            border-radius: 4px;
            margin-bottom: 25px;
        }

        /* Live Readout Dashboard */
        .dashboard {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .metric-card {
            background: #fff;
            border: 2px solid #dee2e6;
            border-radius: 8px;
            padding: 20px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .metric-card.active-status {
            border-color: currentColor;
        }

        .metric-value {
            font-size: 2.5rem;
            font-weight: bold;
            margin: 10px 0;
        }

        /* Interactive Sliders */
        .control-panel {
            background: var(--light-bg);
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 25px;
        }

        .slider-group {
            margin-bottom: 20px;
        }

        .slider-group:last-child {
            margin-bottom: 0;
        }

        .slider-label {
            display: flex;
            justify-content: space-between;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .control-slider {
            width: 100%;
            height: 8px;
            border-radius: 5px;
            outline: none;
            -webkit-appearance: none;
            background: #dee2e6;
        }

        .control-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #0d6efd;
            cursor: pointer;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        /* Cellular / System Feedback Analysis */
        .feedback-box {
            border-top: 3px solid #dee2e6;
            padding-top: 20px;
            margin-top: 25px;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 50px;
            color: white;
            font-weight: bold;
            font-size: 0.9rem;
            text-transform: uppercase;
        }

        .critical-thinking-prompt {
            background: #fff3cd;
            border-left: 5px solid #ffc107;
            padding: 15px;
            border-radius: 4px;
            margin-top: 20px;
        }

        textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ced4da;
            border-radius: 4px;
            resize: vertical;
            font-family: inherit;
            margin-top: 10px;
        }
    </style>
</head>
<body>

<div class="sim-container">
    <h1>🔬 Homeostasis Lab: Cellular-Respiratory Dynamics</h1>
    
    <div class="clinical-scenario">
        <strong>Clinical Case Brief:</strong> A 19-year-old patient with Type 1 Diabetes presents to the ED. Due to an absence of insulin, their cells cannot utilize glucose for energy and have shifted to beta-oxidation of fatty acids, producing an abundance of ketoacids. Cellular homeostasis is crashing.
    </div>

    <!-- Live Patient Dashboard -->
    <div class="dashboard">
        <div class="metric-card" id="ph-card">
            <h3>Arterial pH</h3>
            <div class="metric-value" id="ph-val">7.40</div>
            <span class="status-badge" id="ph-status">Normal</span>
        </div>
        <div class="metric-card">
            <h3>Metabolic State<br><small>(HCO₃⁻ / Kidney)</small></h3>
            <div class="metric-value" id="hco3-val">24 mEq/L</div>
            <span style="color: #6c757d; font-size: 0.85rem;">Normal: 22-26</span>
        </div>
        <div class="metric-card">
            <h3>Respiratory State<br><small>(pCO₂ / Lungs)</small></h3>
            <div class="metric-value" id="pco2-val">40 mmHg</div>
            <span style="color: #6c757d; font-size: 0.85rem;">Normal: 35-45</span>
        </div>
    </div>

    <!-- Interactive Physiological Controls -->
    <div class="control-panel">
        <h2>Physiological Modulators</h2>
        <p>Manipulate the sliders below to discover how the respiratory system compensates for cellular metabolic crises.</p>
        
        <!-- Kidneys/Metabolism (Independent Insult) -->
        <div class="slider-group">
            <div class="slider-label">
                <span>Cellular Acid Burden (Serum Bicarbonate Concentration)</span>
                <span id="hco3-label" style="color: var(--acid-red); font-weight: bold;">24 mEq/L</span>
            </div>
            <input type="range" min="5" max="30" value="24" class="control-slider" id="hco3-slider">
            <small style="color: #6c757d;">Simulates metabolic ketoacid accumulation consuming HCO₃⁻ buffers.</small>
        </div>

        <!-- Lungs (Compensatory Variable) -->
        <div class="slider-group" style="margin-top: 30px;">
            <div class="slider-label">
                <span>Alveolar Ventilation Efficiency (Exhaling pCO₂)</span>
                <span id="pco2-label" style="color: #0d6efd; font-weight: bold;">40 mmHg</span>
            </div>
            <input type="range" min="15" max="60" value="40" class="control-slider" id="pco2-slider">
            <small style="color: #6c757d;">Simulates breathing depth/rate. Lowering pCO₂ represents hyperventilation (Kussmaul breathing).</small>
        </div>
    </div>

    <!-- Physiological System Feedback -->
    <div class="feedback-box">
        <h2>Systemic Analysis</h2>
        <p id="patho-explanation">The cellular buffering systems are currently stable. Carbonic acid and bicarbonate ratios are balanced.</p>
        
        <!-- SIFT / Critical Thinking Audit Integration -->
        <div class="critical-thinking-prompt">
            <strong>Inquiry Lab Prompt:</strong> 
            Set the Metabolic slider to <strong>10 mEq/L</strong> to simulate severe DKA. 
            <ol>
                <li>What happens to the pH if the respiratory system fails to compensate (leaving pCO₂ at 40)?</li>
                <li>Adjust the respiratory slider to simulate Kussmaul respiration. What value of pCO₂ brings the pH closest back to homeostatic survival levels?</li>
            </ol>
            <textarea rows="4" placeholder="Synthesize your pathophysiological rationale here linking the cellular insult to the mechanical respiratory system response..."></textarea>
        </div>
    </div>
</div>

<script>
    const hco3Slider = document.getElementById('hco3-slider');
    const pco2Slider = document.getElementById('pco2-slider');
    
    const hco3Val = document.getElementById('hco3-val');
    const pco2Val = document.getElementById('pco2-val');
    const phVal = document.getElementById('ph-val');
    
    const hco3Label = document.getElementById('hco3-label');
    const pco2Label = document.getElementById('pco2-label');
    
    const phCard = document.getElementById('ph-card');
    const phStatus = document.getElementById('ph-status');
    const pathoExplanation = document.getElementById('patho-explanation');

    function calculatePhysiology() {
        const hco3 = parseFloat(hco3Slider.value);
        const pco2 = parseFloat(pco2Slider.value);
        
        // Update live interface slider labels
        hco3Val.innerText = `${hco3} mEq/L`;
        hco3Label.innerText = `${hco3} mEq/L`;
        pco2Val.innerText = `${pco2} mmHg`;
        pco2Label.innerText = `${pco2} mmHg`;

        // The Henderson-Hasselbalch Equation for Blood Physiology
        // pH = 6.1 + log10( [HCO3-] / (0.0301 * pCO2) )
        const pH = 6.1 + Math.log10(hco3 / (0.0301 * pco2));
        const formattedpH = pH.toFixed(2);
        phVal.innerText = formattedpH;

        // Dynamic State UI Updating based on real clinical thresholds
        let status = "Normal";
        let color = "var(--normal-green)";
        let text = "";

        if (pH < 7.35) {
            status = "Acidosis";
            color = "var(--acid-red)";
        } else if (pH > 7.45) {
            status = "Alkalosis";
            color = "var(--alkali-purple)";
        }

        phCard.style.color = color;
        phStatus.innerText = status;
        phStatus.style.backgroundColor = color;

        // Dynamic Physiological Narrative Generation
        if (hco3 < 22 && pco2 >= 35 && pH < 7.35) {
            text = "⚠️ <strong>Uncompensated Metabolic Acidosis:</strong> Excess ketoacids have severely depleted cellular bicarbonate reserves. The lungs have not yet responded. High hydrogen ion concentrations are disrupting cellular enzyme structures.";
        } else if (hco3 < 22 && pco2 < 35 && pH < 7.35) {
            text = "🏃 <strong>Partially Compensated Metabolic Acidosis:</strong> The brainstem chemoreceptors sensed the cellular acid shift! The patient is exhibiting deep, rapid <strong>Kussmaul breathing</strong>, blowing off CO₂ to drag the pH up toward survival limits.";
        } else if (hco3 < 22 && pco2 < 35 && pH >= 7.35 && pH <= 7.45) {
            text = "✅ <strong>Fully Compensated Metabolic Acidosis:</strong> Incredible. Excellent respiratory effort has blown off enough carbonic gas to return the blood pH to the homeostatic range, despite severe cellular metabolic distress.";
        } else if (hco3 > 26 && pco2 > 45) {
            text = "⚠️ <strong>Compensated Metabolic Alkalosis:</strong> Bicarbonate is high, and the respiratory center has slowed ventilation to retain acid gas to compensate.";
        } else if (pH >= 7.35 && pH <= 7.45 && hco3 >= 22 && hco3 <= 26) {
            text = "🌱 <strong>Perfect Homeostasis:</strong> Cellular metabolism is generating standard waste levels, and mechanical ventilation perfectly balances the carbon dioxide elimination.";
        } else {
            text = "🔄 <strong>Mixed Kinetic Shift:</strong> The systemic environment is actively transitioning between metabolic alterations and chemical compensation.";
        }

        pathoExplanation.innerHTML = text;
    }

    // Attach real-time input event listeners for dynamic computation
    hco3Slider.addEventListener('input', calculatePhysiology);
    pco2Slider.addEventListener('input', calculatePhysiology);

    // Run on initial load
    calculatePhysiology();
</script>

</body>
</html>
